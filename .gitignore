*.pyc
.DS_Store
dist/

# cache do extrato do AIC (94 MB, refeito pelo scripts/cadeia_obra.py)
data/missao/aic_full.json

# base crua de SS/OS (36 MB; recorte vai em data/missao/ssos_min.json)
data/raw/BASE_SS_OS_20082026.txt

# saida de trabalho dos scripts (lotes de leitura, HTML do painel)
scratchpad/

# arquivo temporario do gravador da revisao (um por put, sem valor historico)
.analise/*/ferramentas/_put.json

# rascunho dos agentes da análise (um JSON por ativo antes do put; o que vale está em ck/dados)
.analise/*/tmp/
# dados vivos do checkpoint enquanto os agentes da retrospectiva gravam; entram no commit final
.analise/retro2026/ck/dados/
